# ============================================================
# Docker Compose Buổi 9 – MinIO / Object Storage S3 Demo
# ============================================================
COMPOSE_PROJECT_NAME=minio-demo-buoi9

# ============================================================
# Database (PostgreSQL 16)
# ============================================================
POSTGRES_DB=product_db
POSTGRES_USER=product_user
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ============================================================
# MinIO Root Credentials
# DÀNH RIÊNG CHO QUẢN TRỊ VIÊN / BOOTSTRAP SCRIPT
# Tuyệt đối KHÔNG đưa vào runtime backend service
# LƯU Ý BẢO MẬT: Mọi credentials mẫu đã từng xuất hiện trong Git là
# credentials demo công khai. BẮT BUỘC thay đổi trước khi dùng trong production!
# ============================================================
MINIO_ROOT_USER=minio_admin_user
MINIO_ROOT_PASSWORD=minio_admin_secure_secret_here

# MinIO Console port ánh xạ lên 127.0.0.1 (không xung đột với Buổi 8 đang dùng 9001)
MINIO_CONSOLE_HOST_PORT=9091

# MinIO Image cố định (pinned immutable digest)
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:dc455cdd4db6e390b1b26514f15ff37681a777bf8dab41aac445a0259f751e56

# ============================================================
# MinIO Backend Runtime Credentials (P0 Security Requirement)
# BẮT BUỘC: Sử dụng MinIO Service Account riêng với quyền tối thiểu (Least Privilege)
# Tuyệt đối KHÔNG sử dụng root credentials hoặc để trùng với root
# ============================================================
MINIO_BACKEND_ACCESS_KEY=backend_service_account_key
MINIO_BACKEND_SECRET_KEY=backend_service_account_secret

# Buckets dành riêng cho Buổi 9 (phân cách bằng dấu phẩy)
MINIO_DEMO_BUCKETS=buoi9-assets,buoi9-assets-archive
# Bucket ảnh sản phẩm kế thừa từ Buổi 8
MINIO_BUCKET=product-images

# ============================================================
# Backend
# ============================================================
BACKEND_PORT=3000
BACKEND_1_NAME=backend-1
BACKEND_2_NAME=backend-2

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# Cấu hình Public Presigned URL (ký với domain công khai qua NGINX)
MINIO_PUBLIC_HOST=minio.shop.local
MINIO_PUBLIC_PORT=80
MINIO_PUBLIC_USE_SSL=false
MINIO_PRESIGNED_EXPIRY=300

# ============================================================
# Upload test limit (bytes) – mặc định 5 MiB
# ============================================================
UPLOAD_TEST_LIMIT_BYTES=5242880

# ============================================================
# NGINX Configuration
# ============================================================
# Stage 06 hỗ trợ cả shop.local và minio.shop.local
NGINX_STAGE=06-minio-s3
NGINX_UPSTREAM=upstream-docker.conf
NGINX_IMAGE=nginx:1.30-alpine
